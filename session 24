import numpy as np

# ---------------------------------------------------------
# 3-step input sequence
# ---------------------------------------------------------

x = np.array([1.0, 2.0, 3.0])

# Target output at each time step
y_true = np.array([0.0, 1.0, 1.0])


# ---------------------------------------------------------
# RNN parameters
# ---------------------------------------------------------

W = 0.5       # Input-to-hidden weight
U = 0.8       # Hidden-to-hidden weight
V = 0.7       # Hidden-to-output weight
b = 0.0       # Hidden bias
c = 0.0       # Output bias


# ---------------------------------------------------------
# Forward pass
# ---------------------------------------------------------

h = [0.0]     # h[0] = initial hidden state
y_pred = []

for t in range(3):

    # Calculate hidden state
    h_t = np.tanh(
        W * x[t] +
        U * h[t] +
        b
    )

    h.append(h_t)

    # Calculate output
    y_t = V * h_t + c

    y_pred.append(y_t)


# ---------------------------------------------------------
# Calculate Mean Squared Error loss
# ---------------------------------------------------------

loss = 0

for t in range(3):
    loss += 0.5 * (y_pred[t] - y_true[t]) ** 2

print("Hidden states:")
print(h[1:])

print("\nPredicted outputs:")
print(y_pred)

print("\nLoss:")
print(loss)


# ---------------------------------------------------------
# Backpropagation Through Time
# ---------------------------------------------------------

dW = 0.0
dU = 0.0
dV = 0.0
db = 0.0

# Gradient flowing into the hidden state
dh_next = 0.0

# Go backwards through the sequence
for t in reversed(range(3)):

    # Gradient of loss with respect to output
    dy = y_pred[t] - y_true[t]

    # Gradient for output weight
    dV += dy * h[t + 1]

    # Gradient flowing into hidden state
    dh = dy * V + dh_next

    # Derivative of tanh
    dtanh = (1 - h[t + 1] ** 2) * dh

    # Gradient for input-to-hidden weight
    dW += dtanh * x[t]

    # Gradient for hidden-to-hidden weight
    dU += dtanh * h[t]

    # Gradient for hidden bias
    db += dtanh

    # Pass gradient to previous hidden state
    dh_next = dtanh * U


# ---------------------------------------------------------
# Print gradients
# ---------------------------------------------------------

print("\nGradients obtained using BPTT:")
print("dW =", dW)
print("dU =", dU)
print("dV =", dV)
print("db =", db)
